{
  "globs": [
    "docs/**/*.md",
    "decisions/**/*.md",
    "README.md"
  ],
  "ignores": [
    "node_modules/**",
    "docs/.vitepress/dist/**",
    "docs/.vitepress/cache/**",
    "docs/public/**",
    "defaults/**"
  ],
  "config": {
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD041": false
  }
}
