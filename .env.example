# Local admin (writes to disk, no GitHub OAuth)
ADMIN_LOCAL=true
ADMIN_API_PORT=8787

# Production / Netlify — GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPO=owner/saas-support-handbook
GITHUB_BRANCH=main
GITHUB_OAUTH_CALLBACK=https://your-site.netlify.app/api/auth/callback
# Optional comma-separated allowlist; if empty, requires repo write access
ADMIN_GITHUB_USERS=
SESSION_SECRET=change-me-to-a-long-random-string
